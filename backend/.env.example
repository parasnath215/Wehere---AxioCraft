# Wehere Backend Environment Variables
# ------------------------------------
# Copy this file to .env and configure the variables below.

# [REQUIRED] The port the backend will run on
PORT=4000

# [REQUIRED] PostgreSQL database connection string
# Example: postgresql://postgres:postgres@localhost:5432/wehere_test?schema=public
DATABASE_URL="postgresql://wehere_user:wehere_password@localhost:5432/wehere_db?schema=public"

# [REQUIRED] Secret key for signing JWT tokens. Use a long, random string.
JWT_SECRET="change_me_to_a_secure_random_jwt_secret"

# [REQUIRED] Internal API Key used by the Admin Panel to authenticate with the backend
INTERNAL_API_KEY="change_me_to_a_secure_admin_api_key"

# [REQUIRED] The URL of the frontend (if deployed) or localhost
FRONTEND_URL="http://localhost:8080"

# [REQUIRED] The URL of the admin panel
ADMIN_URL="http://localhost:3000"

# [OPTIONAL] Set to "production" in production environments. "development" or "test" otherwise.
NODE_ENV="development"

# [OPTIONAL] Trust proxy hops behind reverse proxy (e.g., 1 behind Nginx). Defaults to 1 in production.
TRUST_PROXY_HOPS=1

# [OPTIONAL] Test-mode OTP (123456)
# If true and NODE_ENV !== 'production', the OTP '123456' will work for testing.
# In production, setting this to true will cause a fatal startup crash.
TEST_OTP_ENABLED=false

# Brevo (Sendinblue) Transactional Email API (Recommended)
BREVO_API_KEY="xkeysib-your-brevo-api-key"
BREVO_SENDER_EMAIL="grievance@wehere.co.in"
BREVO_SENDER_NAME="Wehere"

# SMTP Mail Configuration (Fallback or alternative)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="user@example.com"
SMTP_PASS="smtp_password"
SMTP_FROM="noreply@wehere.app"

# Google OAuth Client IDs (comma-separated for Android, iOS, Web)
GOOGLE_CLIENT_IDS="your-client-id-1.apps.googleusercontent.com,your-client-id-2.apps.googleusercontent.com"

# Apple OAuth Client IDs (comma-separated bundle IDs e.g. com.wehere.app)
APPLE_CLIENT_IDS="com.wehere.app"

# [OPTIONAL] For create-admin script (one-off execution)
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="super_secure_admin_password"
