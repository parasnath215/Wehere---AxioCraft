generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  username  String?  @unique
  phone     String?  @unique
  password  String?
  role      String   @default("USER") // USER or ADMIN
  isAnonymous Boolean @default(false)
  pseudonym String?
  avatar    String?
  bio       String?
  images    String[] // Added for minimum 2 image upload
  location  String?
  lookingFor String?
  interests String[]
  feelings  String[]
  supportTypes String[]
  photoVersion Int @default(0)
  xp        Int      @default(0)
  level     Int      @default(1)
  currentStreak Int  @default(0)
  lastLoginDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalEntries JournalEntry[]
  messagesSent   Message[]
  matchesInitiated Match[] @relation("MatchesInitiated")
  matchesReceived  Match[] @relation("MatchesReceived")
  posts          CommunityPost[]
  comments       Comment[]
  wellnessGoals  WellnessGoal[]
  contacts       EmergencyContact[]
  swipesInitiated Swipe[] @relation("SwipesInitiated")
  swipesReceived  Swipe[] @relation("SwipesReceived")
  blocksInitiated Block[] @relation("BlocksInitiated")
  blocksReceived  Block[] @relation("BlocksReceived")
  reportsSubmitted Report[] @relation("ReportsSubmitted")
  reportsReceived  Report[] @relation("ReportsReceived")
  notifications  Notification[]
  postLikes      PostLike[]
  moods          DailyMood[]
  isBanned       Boolean @default(false)
  emailVerified  Boolean @default(false)
  emailVerifiedAt DateTime?
  tokenVersion   Int     @default(0)

  otpRecords     OtpRecord[]

  @@index([role])
  @@index([createdAt])
}

model OtpRecord {
  id        String   @id @default(uuid())
  purpose   String   // e.g. "verify_email", "reset_password"
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
  @@index([purpose])
}

model JournalEntry {
  id        String   @id @default(uuid())
  content   String
  moodScore Int      @default(3)
  category  String?
  isPrivate Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@index([createdAt])
}

model Match {
  id        String   @id @default(uuid())
  status    String   @default("pending") // pending, connected, rejected
  matchScore Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userA   User   @relation("MatchesInitiated", fields: [userAId], references: [id], onDelete: Cascade)
  userAId String

  userB   User   @relation("MatchesReceived", fields: [userBId], references: [id], onDelete: Cascade)
  userBId String

  conversation Conversation?

  @@index([userAId])
  @@index([userBId])
  @@index([status])
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId String @unique

  messages Message[]
}

model Message {
  id             String   @id @default(uuid())
  content        String
  createdAt      DateTime @default(now())
  isRead         Boolean  @default(false)
  
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId String
}

model DailyMood {
  id        String   @id @default(uuid())
  mood      String
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
  @@index([createdAt])
}

model CommunityPost {
  id          String   @id @default(uuid())
  topic       String
  content     String
  likesCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  comments    Comment[]
  likes       PostLike[]
}

model Comment {
  id          String   @id @default(uuid())
  content     String
  createdAt   DateTime @default(now())

  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String

  author      User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
}

model WellnessGoal {
  id            String   @id @default(uuid())
  title         String
  subtitle      String?
  categoryColor String   @default("0xFF22C55E")
  progress      Float    @default(0.0)
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
}

model EmergencyContact {
  id            String   @id @default(uuid())
  name          String
  phone         String
  relationship  String?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
}

model Swipe {
  id        String   @id @default(uuid())
  isRight   Boolean
  createdAt DateTime @default(now())

  swiper    User   @relation("SwipesInitiated", fields: [swiperId], references: [id], onDelete: Cascade)
  swiperId  String

  swiped    User   @relation("SwipesReceived", fields: [swipedId], references: [id], onDelete: Cascade)
  swipedId  String

  @@unique([swiperId, swipedId])
  @@index([swiperId])
  @@index([swipedId])
}

model Notification {
  id        String   @id @default(uuid())
  type      String   // match, message, comment, like
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
}

model Block {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  blocker   User   @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String

  blocked   User   @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String

  @@unique([blockerId, blockedId])
}

model Report {
  id               String   @id @default(uuid())
  reason           String
  description      String?
  reportedPhotoUrl String?
  status           String   @default("pending") // pending, reviewed, resolved
  createdAt        DateTime @default(now())

  reporter   User   @relation("ReportsSubmitted", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String

  reported   User   @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  reportedId String
}

model PostLike {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([postId, userId])
}

model ConfigOption {
  id        String   @id @default(uuid())
  type      String   // "INTEREST", "FEELING", "SUPPORT_TYPE"
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([type])
}
