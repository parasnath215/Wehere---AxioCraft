# Root Docker Compose Environment Configuration
# Copy this file to .env before running `docker-compose up`

# PostgreSQL Credentials
POSTGRES_USER=wehere_user
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password
POSTGRES_DB=wehere_db

# Security & Secrets
JWT_SECRET=change_this_to_a_secure_random_jwt_secret
INTERNAL_API_KEY=change_this_to_a_secure_internal_api_key

# URLs
FRONTEND_URL=https://wehere.app
ADMIN_URL=https://admin.wehere.app

# Networking & Proxy
TRUST_PROXY_HOPS=1

# SMTP Email Configuration
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@mg.wehere.app
SMTP_PASS=change_this_smtp_password
SMTP_FROM="Wehere <noreply@wehere.app>"
